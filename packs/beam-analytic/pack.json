{
  "name": "beam-analytic",
  "version": "0.1.0",
  "description": "Closed-form beam checks with zero dependencies: deflection, bending and shear stress, buckling, bearing, a slenderness guard on the theory itself, and a unit/sign guard on the projection.",
  "settles": [
    "tip deflection",
    "mid-span deflection",
    "deflection ratio",
    "span over deflection limit",
    "stiffness",
    "bending stress",
    "root stress",
    "section modulus",
    "transverse shear stress",
    "critical buckling load",
    "column stability",
    "bearing stress",
    "fastener bearing",
    "beam model validity",
    "slenderness",
    "input units and signs",
    "unit consistency",
    "sign convention"
  ],
  "claim_classes": [
    "structural",
    "stiffness",
    "deflection",
    "serviceability",
    "strength",
    "stress",
    "shear",
    "stability",
    "buckling",
    "fastener",
    "joint",
    "model-validity"
  ],
  "provides_gates": [
    "beam.deflection",
    "beam.deflection_ratio",
    "beam.bending_stress",
    "beam.shear_stress",
    "beam.buckling",
    "beam.bearing",
    "beam.model_validity",
    "beam.input_sanity"
  ],
  "provides_generators": [],
  "requires_tools": [],
  "requires_python": [],
  "max_tier": 0,
  "lenses": [
    "load path",
    "the real boundary condition",
    "stress concentration",
    "fatigue vs static",
    "off-axis and eccentric loading",
    "the joint, not the span",
    "units and sign convention"
  ],
  "authors": [],
  "licence": "Apache-2.0",
  "origin": "built by the extension protocol as the analytic-first baseline; formulae from standard strength-of-materials tables, material numbers are order-of-magnitude and flagged as such in every verdict"
}
