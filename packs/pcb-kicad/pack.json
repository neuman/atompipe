{
  "name": "pcb-kicad",
  "version": "0.1.0",
  "description": "Checks a KiCad board and its schematic: DRC, ERC, schematic parity, connectivity, pin names, IPC-2221 trace heating, a fab's limits, ngspice measurements, and fit in its enclosure.",
  "settles": [
    "design rule violations",
    "pcb design rule check",
    "drc",
    "clearance violation",
    "silkscreen clipped by the board edge",
    "unconnected items",
    "unrouted net",
    "open net",
    "library pin-name agreement",
    "pin map",
    "pins shorted through a part",
    "esd array wiring",
    "trace temperature rise",
    "trace width for current",
    "current capacity of a track",
    "board file readability",
    "electrical rule violations",
    "electrical rules check",
    "erc",
    "schematic errors",
    "dangling label",
    "unconnected pin",
    "schematic to board parity",
    "board matches schematic",
    "netlist out of sync",
    "footprint mismatch",
    "fab capability limits",
    "fab minimum track width",
    "minimum drill size",
    "annular ring",
    "silkscreen text height",
    "manufacturable at jlcpcb",
    "simulated circuit measurement",
    "spice simulation",
    "supply droop",
    "voltage at the connector",
    "board fit in its enclosure",
    "enclosure fit",
    "part taller than its cavity",
    "component collides with the lid",
    "board to case clearance"
  ],
  "claim_classes": [
    "pcb",
    "printed-circuit-board",
    "electronics",
    "design-rules",
    "connectivity",
    "copper-connectivity",
    "netlist",
    "pin-map",
    "short-circuit",
    "trace-width",
    "current-capacity",
    "power-integrity",
    "manufacturability",
    "clearance",
    "schematic",
    "electrical-rules",
    "schematic-parity",
    "fab-limits",
    "circuit-simulation",
    "enclosure-fit",
    "packaging",
    "interference"
  ],
  "provides_gates": [
    "pcb.board_readable",
    "pcb.pin_names",
    "pcb.net_width",
    "pcb.drc",
    "pcb.unconnected",
    "pcb.erc",
    "pcb.parity",
    "pcb.fab_rules",
    "pcb.spice",
    "pcb.enclosure_fit"
  ],
  "provides_generators": [],
  "provides_proposers": [
    {
      "id": "pcb.autoroute",
      "basis": "established",
      "description": "Routes a KiCad board with Freerouting (headless, one thread) and proposes the routed copy; the DRC gates judge it once adopted.",
      "run": "proposers/autoroute.py"
    }
  ],
  "requires_tools": [
    "kicad-cli",
    "ngspice"
  ],
  "requires_python": [
    "cadquery"
  ],
  "max_tier": 1,
  "lenses": [
    "what a design rule check cannot see",
    "pins the part joins inside",
    "a width nobody asked for",
    "warnings the gate never read",
    "the waiver nobody named",
    "a connector that fits the wrong cable",
    "parts not in the library",
    "a part taller than its cavity",
    "a simulation of a different circuit"
  ],
  "authors": [],
  "licence": "Apache-2.0",
  "origin": "extracted from an autonomous board pipeline that generated, routed and DRC-checked two 4-layer boards headlessly; its chat logs and history showed which checks caught real defects and which passed defects a person later found. The KiCad knowledge is generic (file format, kicad-cli, the stock libraries); no project's design came with it.",
  "basis": "established"
}
