/*--------------------------------*- C++ -*----------------------------------*\
  aero-openfoam's selftest baseline: a prolate spheroid over a moving ground
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    lowerWall
    {
        type            zeroGradient;
    }
    "(upperWall|frontAndBack)"
    {
        type            slip;
    }
    bodyGroup
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
