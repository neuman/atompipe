/*--------------------------------*- C++ -*----------------------------------*\
  aero-openfoam's selftest baseline: a prolate spheroid over a moving ground
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (20 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform (20 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (20 0 0);
    }
    lowerWall
    {
        type            fixedValue;
        value           uniform (20 0 0);
    }
    "(upperWall|frontAndBack)"
    {
        type            slip;
    }
    bodyGroup
    {
        type            noSlip;
    }
}

// ************************************************************************* //
