{
  "name": "cad-solid",
  "version": "0.1.0",
  "description": "Validates that exported solids are real solids, that placed parts do not interfere, and that every part is held by something: watertightness, validity, clash, contact coverage, envelope, wall.",
  "settles": [
    "watertightness",
    "solid validity",
    "degenerate faces",
    "duplicate vertices",
    "part interference",
    "clash detection",
    "assembly fit",
    "assembly connectivity",
    "mating contact",
    "parts held by nothing",
    "unattached parts",
    "disconnected parts",
    "declared linkage continuity",
    "bounding box",
    "envelope fit",
    "centre of mass",
    "minimum wall thickness"
  ],
  "claim_classes": [
    "geometry",
    "mesh",
    "cad",
    "assembly",
    "fit",
    "manufacturability",
    "envelope",
    "packaging",
    "wall",
    "interference",
    "connectivity",
    "linkage",
    "mechanical"
  ],
  "provides_gates": [
    "cad.bounding",
    "cad.watertight",
    "cad.is_volume",
    "cad.degenerate_faces",
    "cad.wall_thickness",
    "cad.clash",
    "cad.assembly_connected"
  ],
  "provides_views": [
    "assembly"
  ],
  "provides_generators": [],
  "requires_tools": [],
  "requires_python": [
    "trimesh",
    "numpy"
  ],
  "max_tier": 1,
  "lenses": [
    "assembly order",
    "tolerance stack",
    "the pose you did not check",
    "what floats and where it settles",
    "what is held in place by nothing",
    "what is held by something that is not modelled",
    "kernel tolerance budget"
  ],
  "licence": "Apache-2.0",
  "origin": "built by the extension protocol around trimesh, from defects seen repeatedly in exported mechanical assemblies"
}
