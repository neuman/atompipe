    "solid validity",
    "degenerate faces",
    "duplicate vertices",
    "part interference",
    "clash detection",
    "assembly fit",
    "bounding box",
    "envelope fit",
    "centre of mass",
    "minimum wall thickness"
  ],
  "claim_classes": [
    "geometry", "mesh", "cad", "assembly", "fit", "manufacturability",
    "envelope", "packaging", "wall", "interference", "mechanical"
  ],
  "provides_gates": [
    "cad.bounding",
    "cad.watertight",
    "cad.is_volume",
    "cad.degenerate_faces",
    "cad.wall_thickness",
    "cad.clash"
  ],
  "provides_views": ["assembly"],
  "provides_generators": [],
  "requires_tools": [],
