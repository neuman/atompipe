{
  "name": "openmodelica",
  "version": "0.1.0",
  "description": "Validates a Modelica model and the runs recorded from it: parameter units, claim/variable drift, result validity, extracted values, mirror agreement, and equation balance under omc.",
  "settles": [
    "parameter description and unit coverage",
    "parameter units",
    "undescribed parameters",
    "claim variable addressability",
    "claim/model drift",
    "renamed variable",
    "simulation result validity",
    "did the run reach stopTime",
    "NaN in results",
    "steady state reached",
    "settling time",
    "simulated value against acceptance",
    "value extracted from a simulation",
    "final value",
    "peak value",
    "agreement between the model and its mirror",
    "cross-representation agreement",
    "spreadsheet versus model",
    "equation/unknown balance",
    "structurally singular model",
    "model compiles to an executable",
    "simulation runs to completion",
    "assert fires during simulation",
    "acausal equation model",
    "differential algebraic equations",
    "multi-domain physical model",
    "lumped parameter dynamics",
    "transient response"
  ],
  "claim_classes": [
    "modelica",
    "equation-model",
    "simulation-result",
    "result-extraction",
    "cross-representation",
    "model-agreement",
    "mirror-agreement",
    "model-drift",
    "claim-coverage",
    "modelica-source",
    "model-hygiene",
    "parameter-provenance",
    "equation-balance",
    "model-structure",
    "model-compiles",
    "simulation-runs",
    "steady-state",
    "dynamic-response",
    "transient"
  ],
  "provides_gates": [
    "modelica.source_hygiene",
    "modelica.claims_addressable",
    "modelica.solution_valid",
    "modelica.result_claim",
    "modelica.mirror_agrees",
    "modelica.checks",
    "modelica.compiles",
    "modelica.simulates"
  ],
  "provides_generators": [],
  "requires_tools": [
    "omc"
  ],
  "requires_python": [],
  "max_tier": 2,
  "lenses": [
    "well-posedness",
    "initial conditions",
    "solver tolerance versus the effect claimed",
    "step size and output grid",
    "events and chattering",
    "index and structural singularity",
    "what is not modelled at all",
    "the mirror nobody checked",
    "parameter provenance",
    "validity range of the equations"
  ],
  "authors": [],
  "licence": "Apache-2.0",
  "origin": "built by the extension protocol as the textbook case for it: a heavy tier-2 solver (omc) wrapped so it degrades honestly to BLOCKED, with the tier-0 half that catches most real defects doing the work without it. The Modelica knowledge is generic - result-file format, checkModel's balance line, .mos scripting, declaration syntax - extracted from OMC's own behaviour and from reading a real third-party Modelica package; no project's domain content came with it."
}
