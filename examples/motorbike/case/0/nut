//
// "0/nut"
//
FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          nut;
}

dimensions      [ 0 2 -1 0 0 0 0 ];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    frontAndBack
    {
        type            calculated;
        value           uniform 0;
    }
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    lowerWall
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    upperWall
    {
        type            calculated;
        value           uniform 0;
    }
    // nopekit's motorBike demo: Spalding's law, valid from y+ 1 into the log layer
    // (the tutorial's nutkWallFunction assumes the log layer).
    motorBikeGroup
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}
