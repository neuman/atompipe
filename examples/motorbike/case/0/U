//
// "0/U"
//
FoamFile
{
    version         2;
    format          ascii;
    class           volVectorField;
    object          U;
}

flowVelocity    ( 20 0 0 );

pressure        0;

turbulentKE     0.24;

turbulentOmega  1.78;

dimensions      [ 0 1 -1 0 0 0 0 ];

internalField   uniform ( 20 0 0 );

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    inlet
    {
        type            fixedValue;
        value           uniform ( 20 0 0 );
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform ( 0 0 0 );
        value           uniform ( 20 0 0 );
    }
    lowerWall
    {
        type            fixedValue;
        value           uniform ( 20 0 0 );
    }
    motorBikeGroup
    {
        type            noSlip;
    }
    upperWall
    {
        type            slip;
    }
    frontAndBack
    {
        type            slip;
    }
}
