//
// "0/k"
//
FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    object          k;
}

flowVelocity    ( 20 0 0 );

pressure        0;

turbulentKE     0.24;

turbulentOmega  1.78;

dimensions      [ 0 2 -2 0 0 0 0 ];

internalField   uniform 0.24;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    inlet
    {
        type            fixedValue;
        value           uniform 0.24;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.24;
        value           uniform 0.24;
    }
    lowerWall
    {
        type            kqRWallFunction;
        value           uniform 0.24;
    }
    motorBikeGroup
    {
        type            kqRWallFunction;
        value           uniform 0.24;
    }
    upperWall
    {
        type            slip;
    }
    frontAndBack
    {
        type            slip;
    }
}
