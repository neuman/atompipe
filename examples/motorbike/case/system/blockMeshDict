//
// "system/blockMeshDict"
//
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          blockMeshDict;
}

scale           1;

// nopekit's motorBike demo: the tutorial's box (-5 -4 0) (15 4 8) grown to
// x -8..24, y -8..8, z 0..12 so that every distance meets COST 732 (Franke et al.
// 2007) in H, the body's height 1.35 m: inlet, sides and top at least 5 H, outlet
// at least 15 H. The tutorial's box fails four of them (3.48, 9.8, 2.7, 4.92 H).
// Cells stay 1 m cubes, as the tutorial's: (32 16 12).
vertices        ( ( -8 -8 0 ) ( 24 -8 0 ) ( 24 8 0 ) ( -8 8 0 ) ( -8 -8 12 ) ( 24 -8 12 ) ( 24 8 12 ) ( -8 8 12 ) );

blocks          ( hex ( 0 1 2 3 4 5 6 7 ) ( 32 16 12 ) simpleGrading ( 1 1 1 ) );

edges           ( );

boundary        ( frontAndBack { type patch ; faces ( ( 3 7 6 2 ) ( 1 5 4 0 ) ) ; } inlet { type patch ; faces ( ( 0 4 7 3 ) ) ; } outlet { type patch ; faces ( ( 2 6 5 1 ) ) ; } lowerWall { type wall ; faces ( ( 0 3 2 1 ) ) ; } upperWall { type patch ; faces ( ( 4 5 6 7 ) ) ; } );
