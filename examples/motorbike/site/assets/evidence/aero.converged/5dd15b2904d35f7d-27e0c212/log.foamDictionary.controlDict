//
// "system/controlDict"
//
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         500;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     binary;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

writePrecision  12;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            ( forces );
        writeControl    timeStep;
        writeInterval   1;
        writePrecision  12;
        log             false;
        patches         ( motorBikeGroup );
        rho             rhoInf;
        rhoInf          1;
        liftDir         ( 0 0 1 );
        dragDir         ( 1 0 0 );
        CofR            ( 0 0 0 );
        pitchAxis       ( 0 1 0 );
        magUInf         20;
        lRef            1;
        Aref            1;
    }
    solverInfo1
    {
        type            solverInfo;
        libs            ( utilityFunctionObjects );
        fields          ( U p k omega );
        writeResidualFields no;
        writeControl    timeStep;
        writeInterval   1;
    }
    mag1
    {
        type            mag;
        libs            ( fieldFunctionObjects );
        field           U;
        executeControl  onEnd;
        writeControl    onEnd;
    }
    cp1
    {
        type            pressure;
        libs            ( fieldFunctionObjects );
        mode            staticCoeff;
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1;
        pInf            0;
        UInf            ( 20 0 0 );
        executeControl  onEnd;
        writeControl    onEnd;
    }
    cpt1
    {
        type            pressure;
        libs            ( fieldFunctionObjects );
        mode            totalCoeff;
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1;
        pInf            0;
        UInf            ( 20 0 0 );
        executeControl  onEnd;
        writeControl    onEnd;
    }
    surfaces1
    {
        type            surfaces;
        libs            ( sampling );
        executeControl  onEnd;
        writeControl    onEnd;
        surfaceFormat   vtk;
        fields          ( static(p)_coeff total(p)_coeff mag(U) );
        surfaces
        {
            body
            {
                type            patch;
                patches         ( motorBikeGroup );
                interpolate     true;
            }
            wakeIso
            {
                type            isoSurface;
                isoField        total(p)_coeff;
                isoValue        0;
                interpolate     true;
            }
            wakeCut1
            {
                type            cuttingPlane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                    point           ( 1.99629 0 0 );
                    normal          ( 1 0 0 );
                }
                interpolate     true;
            }
            wakeCut2
            {
                type            cuttingPlane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                    point           ( 2.97684 0 0 );
                    normal          ( 1 0 0 );
                }
                interpolate     true;
            }
            wakeCut3
            {
                type            cuttingPlane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                    point           ( 4.50895 0 0 );
                    normal          ( 1 0 0 );
                }
                interpolate     true;
            }
        }
    }
    tracksCentre
    {
        type            streamLine;
        libs            ( fieldFunctionObjects );
        executeControl  onEnd;
        writeControl    onEnd;
        setFormat       vtk;
        U               U;
        direction       forward;
        fields          ( U mag(U) );
        lifeTime        10000;
        nSubCycle       5;
        cloud           tracksCentreCloud;
        seedSampleSet
        {
            type            uniform;
            axis            xyz;
            start           ( -0.45509 -0.0431388 0.0540202 );
            end             ( -0.45509 0.0251168 1.44613 );
            nPoints         60;
        }
    }
    tracksFar
    {
        type            streamLine;
        libs            ( fieldFunctionObjects );
        executeControl  onEnd;
        writeControl    onEnd;
        setFormat       vtk;
        U               U;
        direction       forward;
        fields          ( U mag(U) );
        lifeTime        10000;
        nSubCycle       5;
        cloud           tracksFarCloud;
        seedSampleSet
        {
            type            uniform;
            axis            xyz;
            start           ( -0.45509 0.270837 0.0540202 );
            end             ( -0.45509 0.322029 1.20285 );
            nPoints         18;
        }
    }
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
