//
// "system/surfaceFeatureExtractDict"
//
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          surfaceFeatureExtractDict;
}

motorBike.obj
{
    extractionMethod extractFromSurface;
    includedAngle   150;
    subsetFeatures
    {
        nonManifoldEdges no;
        openEdges       yes;
    }
    writeObj        yes;
}
